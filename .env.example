# Docker Compose deployment configuration — copy to .env and edit.

# PostgreSQL
POSTGRES_PASSWORD=change-me-strong-db-password

# JWT (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# S3 / MinIO
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=pharmasaas
# URL browsers use to load images (your MinIO / S3 public endpoint)
S3_PUBLIC_ENDPOINT=http://localhost:9000

# SMTP (defaults to bundled MailHog for testing; use a real provider in production)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM="PharmaSaaS <no-reply@pharmasaas.com>"

# Platform root domain (tenant subdomains hang off this)
PLATFORM_DOMAIN=pharmasaas.com

# Trial length in days
TRIAL_DAYS=14
