# PharmaSaaS production configuration. Copy to .env and fill every value.
# Generate secrets with:  openssl rand -hex 32

# Root platform domain. Tenant subdomains hang off this
# (e.g. alshifa.pharmasaas.ps). You must own it and control its DNS.
PLATFORM_DOMAIN=pharmasaas.ps

# --- Database ---
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- JWT (32+ char random hex each) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Object storage (bundled MinIO) ---
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=pharmasaas

# --- SMTP (use a real provider: Gmail SMTP, SendGrid, Mailgun, ...) ---
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PharmaSaaS <no-reply@pharmasaas.ps>"

# --- Trial length (days) ---
TRIAL_DAYS=14

# --- Backups ---
BACKUP_RETENTION_DAYS=14
