generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

enum BillingInvoiceStatus {
  PENDING
  PAID
  FAILED
  VOID
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  BANK_TRANSFER
  DIGITAL_WALLET
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT_AGENT
}

enum TenantRole {
  OWNER
  BRANCH_MANAGER
  PHARMACIST
  CASHIER
  INVENTORY_MANAGER
  ACCOUNTANT
}

enum MedicineStatus {
  ACTIVE
  ARCHIVED
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  VOID
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  COUNT
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum InventoryCountType {
  FULL
  CYCLE
  SPOT
}

enum InventoryCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  SALARIES
  RENT
  UTILITIES
  MAINTENANCE
  MARKETING
  MISCELLANEOUS
}

enum LedgerAccount {
  CASH
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  SALES_REVENUE
  SALES_RETURNS
  COST_OF_GOODS_SOLD
  INVENTORY
  TAX_PAYABLE
  EXPENSES
  OWNER_EQUITY
}

enum LedgerSide {
  DEBIT
  CREDIT
}

enum NotificationType {
  LOW_STOCK
  EXPIRY
  SUBSCRIPTION_EXPIRING
  NEW_INVOICE
  PAYMENT_FAILED
  SYSTEM
}

// ---------------------------------------------------------------------------
// Platform: plans, tenants, subscriptions & billing
// ---------------------------------------------------------------------------

model Plan {
  id            String         @id @default(uuid())
  slug          String         @unique
  name          String
  nameAr        String
  description   String?
  priceMonthly  Decimal        @db.Decimal(12, 2)
  priceYearly   Decimal        @db.Decimal(12, 2)
  /// -1 means unlimited
  maxBranches   Int
  /// -1 means unlimited
  maxUsers      Int
  /// -1 means unlimited
  maxProducts   Int
  features      Json           @default("[]")
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  tenants       Tenant[]
}

model Tenant {
  id                 String                @id @default(uuid())
  name               String
  slug               String                @unique
  subdomain          String                @unique
  email              String
  phone              String?
  logoUrl            String?
  address            String?
  timezone           String                @default("Asia/Riyadh")
  currency           String                @default("SAR")
  status             TenantStatus          @default(TRIAL)
  subscriptionPlanId String?
  plan               Plan?                 @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  settings           TenantSetting?
  subscriptions      Subscription[]
  billingInvoices    BillingInvoice[]
  billingPayments    BillingPayment[]
  users              User[]
  branches           Branch[]
  categories         Category[]
  suppliers          Supplier[]
  customers          Customer[]
  medicines          Medicine[]
  batches            Batch[]
  stockItems         StockItem[]
  stockMovements     StockMovement[]
  stockTransfers     StockTransfer[]
  inventoryCounts    InventoryCount[]
  sales              Sale[]
  saleReturns        SaleReturn[]
  purchaseOrders     PurchaseOrder[]
  purchaseInvoices   PurchaseInvoice[]
  purchaseReturns    PurchaseReturn[]
  expenses           Expense[]
  ledgerEntries      LedgerEntry[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  loginHistory       LoginHistory[]

  @@index([status])
}

model TenantSetting {
  id                 String  @id @default(uuid())
  tenantId           String  @unique
  tenant             Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxRate            Decimal @default(15) @db.Decimal(5, 2)
  receiptHeader      String?
  receiptFooter      String?
  nearExpiryDays     Int     @default(90)
  lowStockThreshold  Int     @default(10)
  /// loyalty points earned per 1 unit of currency spent
  loyaltyEarnRate    Decimal @default(1) @db.Decimal(8, 4)
  /// currency value of 1 loyalty point when redeemed
  loyaltyRedeemValue Decimal @default(0.01) @db.Decimal(8, 4)
  invoicePrefix      String  @default("INV")
}

model Subscription {
  id           String             @id @default(uuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId       String
  plan         Plan               @relation(fields: [planId], references: [id])
  status       SubscriptionStatus @default(TRIALING)
  billingCycle BillingCycle       @default(MONTHLY)
  startsAt     DateTime           @default(now())
  endsAt       DateTime
  trialEndsAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  invoices     BillingInvoice[]

  @@index([tenantId, status])
  @@index([status, endsAt])
}

model BillingInvoice {
  id             String               @id @default(uuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  number         String               @unique
  description    String
  amount         Decimal              @db.Decimal(12, 2)
  currency       String               @default("USD")
  status         BillingInvoiceStatus @default(PENDING)
  dueDate        DateTime
  paidAt         DateTime?
  createdAt      DateTime             @default(now())
  payments       BillingPayment[]

  @@index([tenantId, status])
}

model BillingPayment {
  id        String         @id @default(uuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal        @db.Decimal(12, 2)
  method    PaymentMethod  @default(BANK_TRANSFER)
  reference String?
  paidAt    DateTime       @default(now())
  createdAt DateTime       @default(now())

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  platformRole    PlatformRole?
  tenantId        String?
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantRole      TenantRole?
  branchId        String?
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive        Boolean          @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  refreshTokens   RefreshToken[]
  loginHistory    LoginHistory[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  sales           Sale[]
  saleReturns     SaleReturn[]
  purchaseOrders  PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns PurchaseReturn[]
  expenses        Expense[]
  stockMovements  StockMovement[]
  stockTransfers  StockTransfer[]
  inventoryCounts InventoryCount[]
  managedBranches Branch[]         @relation("BranchManager")

  @@index([tenantId])
  @@index([tenantId, tenantRole])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String
  ip        String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------------------
// Branches
// ---------------------------------------------------------------------------

model Branch {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  nameAr         String?
  address        String?
  phone          String?
  managerId      String?
  manager        User?            @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  isMain         Boolean          @default(false)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  users          User[]
  stockItems     StockItem[]
  stockMovements StockMovement[]
  sales          Sale[]
  saleReturns    SaleReturn[]
  purchaseOrders PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  expenses       Expense[]
  inventoryCounts InventoryCount[]
  transfersFrom  StockTransfer[]  @relation("TransferFrom")
  transfersTo    StockTransfer[]  @relation("TransferTo")

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  nameAr      String?
  description String?
  isArchived  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  medicines   Medicine[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Supplier {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  phone            String?
  email            String?
  address          String?
  openingBalance   Decimal           @default(0) @db.Decimal(12, 2)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  medicines        Medicine[]
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Customer {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  email         String?
  loyaltyPoints Int      @default(0)
  totalSpent    Decimal  @default(0) @db.Decimal(14, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sales         Sale[]

  @@index([tenantId])
  @@index([tenantId, phone])
}

model Medicine {
  id                   String                @id @default(uuid())
  tenantId             String
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barcode              String
  sku                  String
  name                 String
  nameAr               String?
  scientificName       String?
  description          String?
  manufacturer         String?
  categoryId           String?
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId           String?
  supplier             Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchasePrice        Decimal               @default(0) @db.Decimal(12, 2)
  sellingPrice         Decimal               @default(0) @db.Decimal(12, 2)
  costPrice            Decimal               @default(0) @db.Decimal(12, 2)
  taxRate              Decimal               @default(0) @db.Decimal(5, 2)
  unit                 String                @default("piece")
  imageUrl             String?
  minStock             Int                   @default(10)
  status               MedicineStatus        @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  batches              Batch[]
  saleItems            SaleItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  stockMovements       StockMovement[]

  @@unique([tenantId, barcode])
  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
}

model Batch {
  id                 String               @id @default(uuid())
  tenantId           String
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medicineId         String
  medicine           Medicine             @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchNumber        String
  manufacturingDate  DateTime?
  expiryDate         DateTime
  costPrice          Decimal              @default(0) @db.Decimal(12, 2)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  stockItems         StockItem[]
  stockMovements     StockMovement[]
  transferItems      StockTransferItem[]
  countItems         InventoryCountItem[]

  @@unique([tenantId, medicineId, batchNumber])
  @@index([tenantId, expiryDate])
  @@index([medicineId, expiryDate])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model StockItem {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([branchId, batchId])
  @@index([tenantId, branchId])
  @@index([batchId])
}

model StockMovement {
  id           String            @id @default(uuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  medicineId   String
  medicine     Medicine          @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchId      String?
  batch        Batch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  type         StockMovementType
  /// signed quantity change (+ in, - out)
  quantity     Int
  balanceAfter Int
  reason       String?
  refType      String?
  refId        String?
  createdAt    DateTime          @default(now())

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, medicineId, createdAt])
}

model StockTransfer {
  id           String              @id @default(uuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number       String
  fromBranchId String
  fromBranch   Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranchId   String
  toBranch     Branch              @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Cascade)
  status       TransferStatus      @default(PENDING)
  userId       String?
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes        String?
  createdAt    DateTime            @default(now())
  completedAt  DateTime?
  items        StockTransferItem[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model StockTransferItem {
  id         String        @id @default(uuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  batchId    String
  batch      Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quantity   Int

  @@index([transferId])
}

model InventoryCount {
  id          String               @id @default(uuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  number      String
  type        InventoryCountType   @default(FULL)
  status      InventoryCountStatus @default(DRAFT)
  userId      String?
  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes       String?
  createdAt   DateTime             @default(now())
  completedAt DateTime?
  items       InventoryCountItem[]

  @@unique([tenantId, number])
  @@index([tenantId, branchId])
}

model InventoryCountItem {
  id          String         @id @default(uuid())
  countId     String
  count       InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  batchId     String
  batch       Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  expectedQty Int
  countedQty  Int?

  @@unique([countId, batchId])
}

// ---------------------------------------------------------------------------
// Sales (POS)
// ---------------------------------------------------------------------------

model Sale {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  number         String
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status         SaleStatus    @default(COMPLETED)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @db.Decimal(12, 2)
  changeAmount   Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @default(CASH)
  loyaltyEarned  Int           @default(0)
  loyaltyRedeemed Int          @default(0)
  notes          String?
  createdAt      DateTime      @default(now())
  items          SaleItem[]
  returns        SaleReturn[]

  @@unique([tenantId, number])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, createdAt])
  @@index([customerId])
}

model SaleItem {
  id          String           @id @default(uuid())
  saleId      String
  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicineId  String
  medicine    Medicine         @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  quantity    Int
  unitPrice   Decimal          @db.Decimal(12, 2)
  costPrice   Decimal          @default(0) @db.Decimal(12, 2)
  discount    Decimal          @default(0) @db.Decimal(12, 2)
  taxRate     Decimal          @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal          @default(0) @db.Decimal(12, 2)
  total       Decimal          @db.Decimal(12, 2)
  returnedQty Int              @default(0)
  /// JSON array of { batchId, quantity } FEFO allocations
  allocations Json             @default("[]")
  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([medicineId])
}

model SaleReturn {
  id        String           @id @default(uuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  saleId    String
  sale      Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  number    String
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason    String?
  total     Decimal          @db.Decimal(12, 2)
  createdAt DateTime         @default(now())
  items     SaleReturnItem[]

  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
}

model SaleReturnItem {
  id         String     @id @default(uuid())
  returnId   String
  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId String
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  quantity   Int
  amount     Decimal    @db.Decimal(12, 2)

  @@index([returnId])
}

// ---------------------------------------------------------------------------
// Purchases
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id         String              @id @default(uuid())
  tenantId   String
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  number     String
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  userId     String?
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  status     PurchaseOrderStatus @default(DRAFT)
  expectedAt DateTime?
  notes      String?
  subtotal   Decimal             @default(0) @db.Decimal(12, 2)
  total      Decimal             @default(0) @db.Decimal(12, 2)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  items      PurchaseOrderItem[]
  invoices   PurchaseInvoice[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model PurchaseOrderItem {
  id          String        @id @default(uuid())
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicineId  String
  medicine    Medicine      @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  quantity    Int
  unitCost    Decimal       @db.Decimal(12, 2)
  receivedQty Int           @default(0)

  @@index([orderId])
}

model PurchaseInvoice {
  id             String                @id @default(uuid())
  tenantId       String
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  number         String
  supplierId     String
  supplier       Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  orderId        String?
  order          PurchaseOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  subtotal       Decimal               @db.Decimal(12, 2)
  discountAmount Decimal               @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal               @default(0) @db.Decimal(12, 2)
  total          Decimal               @db.Decimal(12, 2)
  paidAmount     Decimal               @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime              @default(now())
  items          PurchaseInvoiceItem[]
  returns        PurchaseReturn[]

  @@unique([tenantId, number])
  @@index([tenantId, supplierId])
  @@index([tenantId, createdAt])
}

model PurchaseInvoiceItem {
  id                String               @id @default(uuid())
  invoiceId         String
  invoice           PurchaseInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  medicineId        String
  medicine          Medicine             @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batchId           String?
  batchNumber       String
  manufacturingDate DateTime?
  expiryDate        DateTime
  quantity          Int
  unitCost          Decimal              @db.Decimal(12, 2)
  total             Decimal              @db.Decimal(12, 2)
  returnedQty       Int                  @default(0)
  returnItems       PurchaseReturnItem[]

  @@index([invoiceId])
}

model PurchaseReturn {
  id        String               @id @default(uuid())
  tenantId  String
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   PurchaseInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  number    String
  userId    String?
  user      User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason    String?
  total     Decimal              @db.Decimal(12, 2)
  createdAt DateTime             @default(now())
  items     PurchaseReturnItem[]

  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
}

model PurchaseReturnItem {
  id            String              @id @default(uuid())
  returnId      String
  purchaseReturn PurchaseReturn     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  invoiceItemId String
  invoiceItem   PurchaseInvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  quantity      Int
  amount        Decimal             @db.Decimal(12, 2)

  @@index([returnId])
}

// ---------------------------------------------------------------------------
// Accounting
// ---------------------------------------------------------------------------

model Expense {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  date        DateTime        @default(now())
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([tenantId, date])
  @@index([tenantId, category])
}

model LedgerEntry {
  id          String        @id @default(uuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date        DateTime      @default(now())
  account     LedgerAccount
  side        LedgerSide
  amount      Decimal       @db.Decimal(14, 2)
  description String
  refType     String?
  refId       String?
  createdAt   DateTime      @default(now())

  @@index([tenantId, date])
  @@index([tenantId, account])
}

// ---------------------------------------------------------------------------
// Audit & notifications
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  oldValue   Json?
  newValue   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, resource, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String?
  tenant    Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  titleAr   String?
  body      String
  bodyAr    String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([tenantId, createdAt])
}
