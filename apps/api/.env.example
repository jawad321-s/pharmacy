# Application
NODE_ENV=development
PORT=4000
API_GLOBAL_PREFIX=api/v1
APP_URL=http://localhost:3000
PLATFORM_DOMAIN=pharmasaas.com

# Database
DATABASE_URL=postgresql://pharmasaas:pharmasaas@localhost:5432/pharmasaas?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# S3 compatible storage (MinIO in development)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pharmasaas
S3_FORCE_PATH_STYLE=true

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PharmaSaaS <no-reply@pharmasaas.com>"

# Trial
TRIAL_DAYS=14
